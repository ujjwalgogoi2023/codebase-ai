{
  "repository": "codebaseai-backend",
  "source_path": "backend",
  "description": "Retrieval evaluation set for CodebaseAI, labelled against its own backend. Questions are phrased the way a developer would ask them rather than by quoting identifiers, so a hit requires semantic retrieval rather than keyword overlap. A question is correct if any expected file appears among the top-K retrieved chunks.",
  "labelling_notes": [
    "expected_files is a list because more than one file can legitimately answer a question.",
    "Paths are relative to the indexed root (backend/) and matched by suffix.",
    "expected_symbols is optional and scored separately as a stricter check."
  ],
  "questions": [
