# ---- Provider credentials ----
OPENAI_API_KEY=sk-your-key-here

# ---- Database ----
DATABASE_URL=postgresql+psycopg://codebaseai:codebaseai@localhost:5433/codebaseai

# ---- Models (provider-agnostic knobs, see app/config.py) ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ---- Retrieval tuning ----
TOP_K=10
RERANK_TOP_K=3

# ---- Indexing limits ----
MAX_FILE_BYTES=1000000
MAX_CHUNK_LINES=120
