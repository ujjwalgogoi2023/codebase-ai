# ---- Provider credentials ----
OPENAI_API_KEY=sk-your-key-here

# ---- Database ----
DATABASE_URL=postgresql+psycopg://codebaseai:codebaseai@localhost:5433/codebaseai

# ---- Models (provider-agnostic knobs, see app/config.py) ----
# Providers: 'openai' (paid), 'ollama' (free, local), 'fake' (offline tests).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Free local alternative. Install Ollama, then:
#   ollama pull qwen3-embedding:0.6b
#   ollama pull qwen2.5:7b
#   ollama create qwen2.5-8k -f ollama/qwen2.5-8k.Modelfile
# and use these instead (changing EMBEDDING_DIM needs init_db.py --reset):
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIM=1024
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-8k
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Retrieval tuning ----
TOP_K=10
RERANK_TOP_K=3

# 'llm' re-scores candidates with the model; 'identity' keeps the vector
# order and is the control group for the reranking experiment.
RERANKER=llm
RERANK_PREVIEW_LINES=18

# HNSW recall/latency dial: higher = better recall, slower queries.
HNSW_EF_SEARCH=64

# ---- Indexing limits ----
MAX_FILE_BYTES=1000000
MAX_CHUNK_LINES=120
